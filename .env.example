HOST=127.0.0.1
PORT=4000
DATA_DIR=./data

# Web app (apps/web). Move WEB_PORT when another program is using 3000.
WEB_PORT=3000
# Server-side only. Must match the API port above.
SERVER_URL=http://127.0.0.1:4000

# Provider credentials live only in the server environment. They are never sent
# to the web app and never written into data/.

# Public https origin Plivo reaches for call callbacks and the audio socket.
# A tunnel origin locally, or the VM's public https hostname in production.
# Example on exe.dev: https://<vm>.exe.xyz (no trailing slash, no :8000).
PUBLIC_BASE_URL=

# Telephony: plivo (default) or fake for local work that must never dial.
# Starting choice until the Settings page saves one.
TELEPHONY_PROVIDER=plivo
# Auth ID and Auth Token (reveal the token with the eye icon):
# https://console.plivo.com/dashboard/
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# A voice-capable number in E.164. Rent one at:
# https://console.plivo.com/phone-numbers/
# India outbound calls must use a Plivo-rented Indian number:
# https://www.plivo.com/docs/numbers/compliance
PLIVO_CALLER_ID=
# Leave true. What the check is:
# https://www.plivo.com/docs/voice/concepts/signature-validation
PLIVO_VERIFY_SIGNATURE=true

# Voice backend: elevenlabs (default) or fake.
# Starting choice until the Settings page saves one.
VOICE_PROVIDER=elevenlabs
# Create a key and allow Agents (Conversational AI), not text-to-speech only:
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Create an agent, open it, and copy the id from the end of the page URL:
# https://elevenlabs.io/app/conversational-ai
# https://elevenlabs.io/docs/eleven-agents/quickstart
ELEVENLABS_AGENT_ID=

# Field extraction goes through resilient-llm, so any provider it supports
# works: openai, anthropic, google, openrouter, ollama.
# These two are the starting choice. After a save on the Settings page, that
# saved provider and model are what the next call uses.
EXTRACTION_PROVIDER=openrouter
EXTRACTION_MODEL=openrouter/free
# Used when that provider's own key below is unset. The provider's own key wins
# when both are set, so the Settings page can switch providers.
EXTRACTION_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Call guardrails, in seconds.
MAX_CALL_SECONDS=240
SILENCE_SECONDS=20
DIAL_TIMEOUT_SECONDS=45

# Calling hours. Unset or false: outside the window warns, and an organizer can
# continue after confirming the risk twice. true: never dial outside the window.
# The Settings page shows which mode this server is in. Restart after changing it.
STRICT_CALLING_HOURS=false
